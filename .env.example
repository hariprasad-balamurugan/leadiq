# ==============================================================================
# LeadIQ Monorepo Environment Variables Template
# ==============================================================================

# Backend Port
PORT=5000

# MongoDB URI (leave blank for local in-memory fallback, or provide your Atlas cluster URI)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/leadiq?retryWrites=true&w=majority
MONGODB_URI=

# Node Environment
NODE_ENV=development
