# ==============================================================================
# LeadIQ Backend Environment Variables
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection URI
# Leave blank to use the built-in in-memory MongoDB Server fallback (zero-configuration local dev).
# To enable persistent storage across restarts, provide a MongoDB Atlas or local MongoDB connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/leadiq?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/leadiq
MONGODB_URI=

# Node Environment
NODE_ENV=development
